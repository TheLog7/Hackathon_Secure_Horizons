# Copy to .env and adjust. Never commit real credentials.

# Bedrock: set to true to call the real Claude model (requires AWS creds + network)
USE_REAL_BEDROCK=false
AWS_REGION=us-east-1

# Model to use. In real mode this should be a cross-Region inference profile ID that
# exists in your account. The engine will try to auto-resolve one at startup.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5-20251101-v1:0

# Service URLs (used for inter-service calls)
ENGINE_URL=http://localhost:8000

# SQLite database path
DB_PATH=secure_horizons.db
